                <div class="bg-gray-800 p-3 rounded text-sm font-mono break-all text-gray-300 border border-gray-700">
                    <span class="text-gray-400">Escrow Account:</span><br>
                    rs1txDg154xTwvubiZbxNgNBV42JnHFaaS
                </div>
            </div>
            <a href="https://testnet.xrpl.org/accounts/rs1txDg154xTwvubiZbxNgNBV42JnHFaaS" target="_blank" rel="noopener noreferrer" class="shrink-0 bg-transparent border-2 border-brand-accent text-brand-accent hover:bg-brand-accent hover:text-white font-bold py-2 px-6 rounded transition-colors">
                익스플로러에서 확인 ↗
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100">
                <div class="text-3xl mb-3">⚡️</div><div class="font-bold text-gray-800">결제 리드타임 제로</div>
            </div>
            <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100">
                <div class="text-3xl mb-3">🔍</div><div class="font-bold text-gray-800">100% 자금 투명성</div>
            </div>
            <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100">
                <div class="text-3xl mb-3">🛡️</div><div class="font-bold text-gray-800">상대방 리스크 제거</div>
            </div>
            <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100">
                <div class="text-3xl mb-3">🔌</div><div class="font-bold text-gray-800">B2B 플랫폼 API 연동</div>
            </div>
        </div>
    </section>

    <!-- 7. Footer -->
    <footer class="bg-gray-900 text-gray-400 text-center py-8">
        <p class="font-bold text-white mb-2">Team BlockBlock</p>
        <p class="text-sm">© 2026 Korea Financial Innovation Program Demo.</p>
    </footer>

    <!-- Interactive Logic -->
    <script>
        let currentStep = 1;
        const totalSteps = 4;
        
        const buttonTexts = [
            "거래 생성하기",
            "대금 예치하기 (Escrow)",
            "수취 검수 및 확인",
            "정산금 지급 실행",
            "데모 초기화"
        ];

        function nextStep() {
            // Hide current step
            document.getElementById(`step-${currentStep}`).classList.add('hidden');
            
            if (currentStep < totalSteps) {
                currentStep++;
            } else {
                currentStep = 1; // Reset demo
            }

            // Show next step
            document.getElementById(`step-${currentStep}`).classList.remove('hidden');
            
            // Update UI components
            updateProgressBar();
            updateLabels();
            
            // Update button text
            document.getElementById('action-btn').innerText = buttonTexts[currentStep - 1];
            
            // Button style change on last step
            if(currentStep === totalSteps) {
                document.getElementById('action-btn').classList.remove('bg-brand-dark');
                document.getElementById('action-btn').classList.add('bg-brand-accent');
            } else {
                document.getElementById('action-btn').classList.add('bg-brand-dark');
                document.getElementById('action-btn').classList.remove('bg-brand-accent');
            }
        }

        function updateProgressBar() {
            const percentage = (currentStep / totalSteps) * 100;
            document.getElementById('progress-bar').style.width = `${percentage}%`;
        }

        function updateLabels() {
            const labels = document.getElementById('step-labels').children;
            for(let i=0; i<labels.length; i++) {
                if(i < currentStep) {
                    labels[i].className = "text-brand-accent transition-colors duration-300";
                } else {
                    labels[i].className = "text-gray-500 transition-colors duration-300";
                }
            }
        }
    </script>
